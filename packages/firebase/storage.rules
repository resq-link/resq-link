rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // KYC government ID photos
    match /kyc-documents/{uid}/{fileName} {
      allow write: if isOwner(uid)
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow read: if isOwner(uid) || isSuperAdmin();
    }

    // Emergency report photos & chat photos - stored in emergencies/photos/
    match /emergencies/photos/{photoId} {
      // Allow authenticated users to upload photos for emergency reports & chat
      allow write: if isAuthenticated() 
                   && request.resource.size < 10 * 1024 * 1024  // 10MB max file size
                   && request.resource.contentType.matches('image/.*');
      
      // Allow read so apps and web dispatchers can view photos
      allow read: if true;
    }

    // Incident chat photos - incident_chats/{incidentId}/{photoId} & incident-chats/{incidentId}/{photoId}
    match /incident_chats/{incidentId}/{photoId} {
      allow write: if isAuthenticated()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }

    match /incident-chats/{incidentId}/{photoId} {
      allow write: if isAuthenticated()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }

    // Responder post-incident report photos - post-reports/{incidentId}/{photoId}
    // Read is public so dispatcher web <img> tags can load URLs without Firebase Auth headers.
    match /post-reports/{incidentId}/{photoId} {
      allow write: if isAuthenticated()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow read: if true;
    }

    // Responder on-scene assessment photos - scene-assessment/{incidentId}/{photoId}
    match /scene-assessment/{incidentId}/{photoId} {
      allow write: if isAuthenticated()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow read: if true;
    }

    // Touchdown on-scene arrival photos - incidents/{incidentId}/on-scene/{photoId}
    match /incidents/{incidentId}/on-scene/{photoId} {
      allow write: if isAuthenticated()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow read: if true;
    }

    // Scene assessment action photos - incidents/{incidentId}/action/{photoId}
    match /incidents/{incidentId}/action/{photoId} {
      allow write: if isAuthenticated()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow read: if true;
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

