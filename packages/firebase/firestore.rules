rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is a command center user
    function isCommandCenter() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/commandCenters/$(request.auth.uid)) ||
        request.auth.token.role == 'command_center' ||
        request.auth.token.isCommandCenter == true
      );
    }
    
    // Helper function to check if user is a dispatcher
    function isDispatcher() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/dispatchers/$(request.auth.uid));
    }
    
    // Super Admin identity — keep in sync with resolveWebWorkspace():
    // admins/{uid} doc and/or Auth custom claims (role / isSuperAdmin).
    function superAdminFromClaims() {
      return request.auth.token.isSuperAdmin == true
             || request.auth.token.role == 'super_admin'
             || request.auth.token.role == 'superadmin'
             || request.auth.token.role == 'platform_admin';
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
             exists(/databases/$(database)/documents/admins/$(request.auth.uid))
             || superAdminFromClaims()
           );
    }
    
    // Administrative audit trail — Super Admin may read; only Admin SDK may write.
    // Incident, emergency, SMS, call-session, and footage rules are intentionally unchanged
    // in this pass to avoid breaking Dispatcher / Civilian / Responder apps.
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Super Admin awareness inbox — client may LIST/GET own recipientUid docs for realtime.
    // Create/update/delete stay Admin SDK only (mark-read / clear / delete API routes).
    match /adminNotifications/{notificationId} {
      allow read: if isSuperAdmin()
                  && resource.data.recipientUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Agency directory — Admin SDK only for privileged mutations.
    match /agencies/{agencyId} {
      allow read: if isSuperAdmin() || isCommandCenter() || isDispatcher();
      allow write: if false;
    }

    // Admins collection - only super admins can read (used for auth check)
    match /admins/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }
    
    // Users collection - users can read/update their own profile
    match /users/{userId} {
      allow read: if isOwner(userId) || isCommandCenter() || isDispatcher() || isSuperAdmin();
      allow create: if (isAuthenticated() && isOwner(userId)) || isSuperAdmin();
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    // Email OTP codes are written/read only by the Admin SDK (API routes).
    match /emailOtps/{email} {
      allow read, write: if false;
    }

    // Password-reset OTP codes are written/read only by the Admin SDK (API routes).
    match /passwordResetOtps/{email} {
      allow read, write: if false;
    }
    
    // Dispatchers collection - dispatchers can read their own, command center can read all
    match /dispatchers/{userId} {
      // Allow reading individual dispatcher documents and collection queries
      // Command center can read all dispatchers (needed for getAllDispatchers query)
      // Any dispatcher/responder account can read peer dispatchers (online counts, team views)
      allow read: if isOwner(userId) || isCommandCenter() || isSuperAdmin() || isDispatcher();
      allow create: if (isAuthenticated() && isOwner(userId)) || isSuperAdmin();
      allow update: if isOwner(userId) || isCommandCenter() || isSuperAdmin();
      allow delete: if isCommandCenter() || isSuperAdmin();
    }
    
    // Command Centers collection - command centers can read their own
    match /commandCenters/{userId} {
      allow read: if isOwner(userId) || isCommandCenter() || isSuperAdmin() || isDispatcher();
      allow create: if (isAuthenticated() && isOwner(userId)) || isSuperAdmin();
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isOwner(userId) || isSuperAdmin();
    }
    
    // Footage requests (civilian submit; command center / dispatchers manage status)
    match /footageRequests/{requestId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'userId', 'purpose', 'purposeOtherText', 'locationText', 'notes',
          'incidentDate', 'status', 'createdAt', 'updatedAt'
        ]);

      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isCommandCenter() ||
        isDispatcher()
      );

      allow update: if isAuthenticated() && (isCommandCenter() || isDispatcher());

      allow delete: if isCommandCenter();
    }

    // Emergency Reports collection
    match /emergencies/{reportId} {
      function isEmergencyOwner() {
        return isAuthenticated() && resource.data.userId == request.auth.uid;
      }

      function isCivilianAdditionalDetailsUpdate() {
        return isEmergencyOwner() &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'additionalDetails',
            'additionalDetailsSubmittedAt',
            'updatedAt'
          ]);
      }

      // Anyone authenticated can create an emergency report
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['userId', 'incidentType', 'locationText', 'status', 'createdAt']);
      
      // Allow authenticated users to read all emergency reports
      // This is appropriate for a command center dashboard where authenticated users should see all emergencies
      // Dispatchers can query by dispatcherId to see only their assigned emergencies
      allow read: if isAuthenticated();
      
      // Command center and dispatchers can update reports freely.
      // Civilians can only submit additional detail payloads for their own report.
      allow update: if isAuthenticated() && 
                      (isCommandCenter() || isDispatcher() || isCivilianAdditionalDetailsUpdate());
      
      // Only command center can delete reports
      allow delete: if isCommandCenter();
    }

    // Incident type rules (managed configuration)
    match /incidentTypeRules/{ruleId} {
      // Authenticated operational users can read the catalog used for routing.
      allow read: if isAuthenticated();

      // Command center operators manage routing rules from the dispatcher app.
      allow create, update, delete: if isSuperAdmin() || isCommandCenter() || isDispatcher();
    }

    // Incidents created by command centers or dispatchers
    match /incidents/{incidentId} {
      // Allow command center, dispatchers, or super admins to create incidents
      allow create: if isAuthenticated()
        && (isCommandCenter() || isDispatcher() || isSuperAdmin());

      // Allow authenticated users to read all incidents
      allow read: if isAuthenticated();

      // Allow command center or dispatcher or super admin to update
      allow update: if isSuperAdmin()
        || isCommandCenter()
        || isDispatcher();

      // Command centers or super admins can remove incidents
      allow delete: if isSuperAdmin()
        || isCommandCenter();

      // Team assignment history audit subcollection
      match /teamAssignmentHistory/{historyId} {
        allow read: if isAuthenticated();
        allow create: if isSuperAdmin() || isCommandCenter() || isDispatcher();
        allow update, delete: if isSuperAdmin() || isCommandCenter();
      }
    }

    // SMS records are written only by the gateway Cloud Functions. Dispatcher-side
    // accounts may read the operational queue; raw phone data is never public.
    match /smsThreads/{threadId} {
      allow read: if isCommandCenter() || isDispatcher() || isSuperAdmin();
      allow write: if false;
    }
    match /smsMessages/{messageId} {
      allow read: if isCommandCenter() || isDispatcher() || isSuperAdmin();
      allow write: if false;
    }
    match /smsIntakes/{intakeId} {
      allow read: if isCommandCenter() || isDispatcher() || isSuperAdmin();
      allow write: if false;
    }
    // Dispatcher-managed, reusable SMS acknowledgement and triage prompts.
    match /smsQuickReplies/{replyId} {
      allow read: if isCommandCenter() || isDispatcher() || isSuperAdmin();
      allow create, update, delete: if isCommandCenter() || isDispatcher() || isSuperAdmin();
    }

    // System Settings (SMS Gateway configuration, etc.)
    match /systemSettings/{settingId} {
      allow read: if isCommandCenter() || isDispatcher() || isSuperAdmin();
      allow create, update, delete: if isCommandCenter() || isSuperAdmin();
    }

    // Resources collection
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (isCommandCenter() || isDispatcher());
    }

    // Resource dispatch ledger for incident/resource assignments.
    match /incidentDispatches/{dispatchId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (isCommandCenter() || isDispatcher() || isSuperAdmin());
    }

    // Incident/report voice call requests. Mobile civilians create their own
    // ringing sessions; command center/dispatchers can observe and answer them.
    match /callSessions/{sessionId} {
      function isCallOwner() {
        return isAuthenticated() && resource.data.callerUserId == request.auth.uid;
      }

      function isNewCallOwner() {
        return isAuthenticated() && request.resource.data.callerUserId == request.auth.uid;
      }

      allow create: if isAuthenticated()
        && request.resource.data.callerUserId == request.auth.uid
        && request.resource.data.status in ['ringing', 'queued'];

      allow read: if isAuthenticated();

      allow update: if isAuthenticated();

      allow delete: if isCommandCenter() || isSuperAdmin();
    }

    // Incident Chats collection (civilian <-> dispatcher <-> responder direct incident messaging)
    match /incidentChats/{incidentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }


    // Teams collection - shared operational team definitions
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (isCommandCenter() || isSuperAdmin());
    }

    // Public Advisories and broadcasts
    match /advisories/{advisoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isCommandCenter() || isDispatcher() || isSuperAdmin();
    }

    // Operational chat threads and messages
    match /chatThreads/{threadId} {
      function isChatParticipant() {
        return isAuthenticated() && request.auth.uid in resource.data.participantIds;
      }

      function isRequestParticipant() {
        return isAuthenticated() && request.auth.uid in request.resource.data.participantIds;
      }

      allow read: if isChatParticipant();
      allow create: if isAuthenticated()
        && isRequestParticipant()
        && request.resource.data.keys().hasAll([
          'type', 'participantIds', 'participantRoles', 'participantNames',
          'createdByUserId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.participantIds.size() >= 2;
      allow update: if isChatParticipant()
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.participantRoles == resource.data.participantRoles
        && request.resource.data.createdByUserId == resource.data.createdByUserId;
      allow delete: if false;

      match /messages/{messageId} {
        function parentThread() {
          return get(/databases/$(database)/documents/chatThreads/$(threadId));
        }

        function isMessageParticipant() {
          return isAuthenticated() &&
            (
              request.auth.uid in resource.data.participantIds ||
              request.auth.uid in parentThread().data.participantIds
            );
        }

        function isNewMessageParticipant() {
          return isAuthenticated() && request.auth.uid in parentThread().data.participantIds;
        }

        allow read: if isMessageParticipant();
        allow create: if isNewMessageParticipant()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasAll(['threadId', 'senderId', 'senderName', 'participantIds', 'text', 'createdAt'])
          && request.resource.data.threadId == threadId
          && request.resource.data.participantIds == parentThread().data.participantIds;
        allow update, delete: if false;
      }
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

