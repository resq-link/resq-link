{
	"cli": {
		"version": ">= 15.0.15",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			},
			"env": {
				"EAS_SKIP_AUTO_FINGERPRINT": "1"
			}
		},
		"production": {
			"autoIncrement": true,
			"env": {
				"EAS_SKIP_AUTO_FINGERPRINT": "1"
			}
		}
	},
	"submit": {
		"production": {
			"android": {
				"track": "internal"
			},
			"ios": {
				"ascAppId": "6804236040"
			}
		}
	}
}
