# Firebase (required)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: Google Sign-In
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# API endpoints (optional)
# Production builds default to https://www.resq-link.com for email OTP and password reset.
# EXPO_PUBLIC_OTP_API_URL=https://www.resq-link.com
# EXPO_PUBLIC_API_URL=https://www.resq-link.com

# Local development only — point at your machine's Next.js dev server (port 3000).
# Requires: npm run dev:web from repo root, phone on same Wi-Fi, Windows Firewall open.
# EXPO_PUBLIC_USE_LOCAL_API=true
# EXPO_PUBLIC_OTP_API_URL=http://192.168.x.x:3000
