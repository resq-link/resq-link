{
  "expo": {
    "name": "RESQ-Link",
    "slug": "resq-link",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "resqlink",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tuguegarao.resqlink",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.tuguegarao.resqlink"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "backgroundColor": "#00000000"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to report emergencies accurately.",
          "locationAlwaysPermission": "Allow $(PRODUCT_NAME) to use your location to report emergencies accurately.",
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to report emergencies accurately."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "apiUrl": "http://localhost:4000",
      "uiMode": false,
      "eas": {
        "projectId": "6f35acd3-b528-4968-ad8d-c21f0162886d"
      }
    },
    "owner": "grymarkers-team"
  }
}
