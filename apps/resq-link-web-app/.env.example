# Firebase client config (safe to expose in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Mapbox Configuration
# Get your access token from https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Optional: Mapbox style (default: mapbox/streets-v12)
NEXT_PUBLIC_MAPBOX_STYLE=mapbox/streets-v12

# Server-only: Gemini API key for the command-center AI assistant.
# Do not prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server-only: Firebase Admin credentials for authenticated API routes.
# Use an absolute path locally, or FIREBASE_SERVICE_ACCOUNT_JSON in hosting.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Agora RTC token generation. Keep AGORA_APP_CERTIFICATE server-side only.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=3600

# Resend (civilian email OTP + KYC approval emails). Server-only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=RESQ-Link <onboarding@resend.dev>
